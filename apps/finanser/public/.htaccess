# Заголовки кэша — на случай, если статику отдаёт Apache.
#
# Сейчас её отдаёт nginx, и этот файл не работает: проверено живьём, `sw.js`
# как приходил с `max-age=3888000`, так и приходит. Оставлен потому, что при
# переезде на другой хостинг он сработает и правило окажется уже записанным;
# но полагаться на него нельзя, и настоящее исправление живёт в `src/pwa.ts` —
# адрес воркера помечен отпечатком сборки, и кэш до него не дотягивается.
<FilesMatch "^sw\.js$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header unset Cache-Control
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Ассеты с хешем в имени: содержимое под этим адресом не меняется никогда,
# новая версия приезжает под новым именем.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
