# зависимости
node_modules/
.pnpm-store/
.pnpm-debug.log*

# сборка
dist/
.vite/
*.tsbuildinfo

# `build/` здесь НЕ игнорируется намеренно.
# Правило стояло с первого коммита — писалось под вывод сборки, — и молча
# унесло apps/finanser/build/pwa.ts, который никакой не вывод, а исходник
# PWA-плагина. Чистый клон из-за этого не собирался вовсе: vite не находил
# ./build/pwa.ts в своём конфиге. Единственный каталог build/ в репозитории —
# как раз этот, так что правило ничего не защищало.
# Вывод сборки лежит в dist/, и он выше.

# cloudflare / wrangler
.wrangler/
.dev.vars
.dev.vars.*
worker-configuration.d.ts

# окружение
.env
.env.*
!.env.example

# тесты
coverage/

# логи
*.log
npm-debug.log*
yarn-error.log*

# редакторы и ос
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# claude code: агенты и CLAUDE.md коммитятся, локальные настройки — нет
.claude/settings.local.json

# банковские выписки и присланные архивы — в историю не идут
# В архиве прототипа лежала настоящая годовая выписка, банковский PDF и
# коммерческие начертания шрифта. Git помнит навсегда: выписка — это год
# чужой жизни, а лицензия на веб-начертания ещё не проверена (О-3).
# Файлы остаются на диске, просто не попадают в репозиторий.
*.zip
*.csv

# доступы к хостингу: логин и путь на сервере. Репозиторий открытый, и логин
# вместе с адресом сервера — половина пары «логин-пароль» и готовая мишень для
# перебора. Пароля в файле нет и быть не должно.
deploy.env

# чертежи заказчиков — в историю не идут
# Репозиторий открытый, а планировка объекта — материал под NDA. Имя файла несёт
# шифр объекта и марку комплекта, сам чертёж даёт геометрию этажа до миллиметра.
# Та же логика, что и с выпиской выше: Git помнит навсегда, открепить потом
# нельзя без переписывания истории.
*.dwg
*.dxf
scripts/чертёжер/out/

# python: окружение разового инструмента. Прецедент — scripts/build-fonts.py:
# зависимости живут в локальном .venv и в репозиторий не попадают.
.venv/
__pycache__/
*.pyc

# пути к эталонным чертежам: у каждого свои, и они ведут к файлам под NDA.
# Сами числа по ним (scripts/чертёжер/эталоны.json) коммитятся — это агрегаты,
# геометрию объекта они не раскрывают.
scripts/чертёжер/эталоны-пути.json
